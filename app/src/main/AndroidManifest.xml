<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Ubicación -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Notificaciones (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Emergencia / Audio -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Servicio en primer plano (Ubicación) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:name=".NexoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_nexo"
        android:roundIcon="@drawable/logo_nexo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nexo.NoActionBar"
        tools:targetApi="31">

        <!-- 🗺Google Maps API KEY -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyA-3F1SseW3AbiDkWykE_bmPyEcBRsmNVM" />

        <!-- Requerido por Google Play Services -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <!-- Servicio de Ubicación en Segundo Plano -->
        <service
            android:name=".services.LocationForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Administrador de Dispositivos (Prevención de Desinstalación / Modo Parental) -->
        <receiver
            android:name=".utils.AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- LAUNCHER -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Autenticación -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="Iniciar sesión" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:label="Crear cuenta" />

        <!-- Home / Menú -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- 🗺Mapa -->
        <activity
            android:name=".MapActivity"
            android:exported="false"
            android:theme="@style/Theme.Nexo.NoActionBar" />

        <!-- Contactos / Familia -->
        <activity
            android:name=".ContactsActivity"
            android:exported="false"
            android:theme="@style/Theme.Nexo.NoActionBar" />

        <!-- Rutas -->
        <activity
            android:name=".RoutesActivity"
            android:exported="false"
            android:theme="@style/Theme.Nexo.NoActionBar" />

        <activity
            android:name=".CreateRouteActivity"
            android:exported="false"
            android:theme="@style/Theme.Nexo.NoActionBar" />

        <!-- Perfil -->
        <activity
            android:name=".PerfilActivity"
            android:exported="false"
            android:theme="@style/Theme.Nexo.NoActionBar" />

        <!-- Configuración -->
        <activity
            android:name=".ConfiguracionActivity"
            android:exported="false"
            android:theme="@style/Theme.Nexo.NoActionBar" />

        <activity
            android:name=".SobreAlertasActivity"
            android:exported="false"
            android:theme="@style/Theme.Nexo.NoActionBar" />

        <!-- Chat -->
        <activity
            android:name=".ChatListActivity"
            android:exported="false"
            android:theme="@style/Theme.Nexo.NoActionBar" />

        <activity
            android:name=".ChatActivity"
            android:exported="false" />

    </application>

</manifest>
