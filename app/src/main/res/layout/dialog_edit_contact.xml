<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="24dp">

    <!-- Encabezado con Icono, Nombre y Opciones de Mapa y Chat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageView
            android:id="@+id/ivContactProfile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_person"
            android:tint="#156082"
            android:background="@drawable/badge_background"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar Contacto"
                android:textColor="#156082"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre Actual"
                android:textColor="#757575"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStartChat"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Chat"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_send"
            android:drawableTint="#FFFFFF"
            android:background="@drawable/button_rounded_primary"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnViewMap"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Mapa"
            android:textColor="#156082"
            android:textSize="12sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/baseline_map_24"
            android:drawableTint="#156082"
            android:background="@drawable/edittext_background"
            android:paddingStart="8dp"
            android:paddingEnd="10dp" />

    </LinearLayout>

    <!-- Campo de Nombre -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre del contacto:"
        android:textColor="#156082"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etEditContactName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre del contacto"
        android:inputType="textPersonName"
        android:textColor="#000000"
        android:textColorHint="#757575"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="@drawable/edittext_background"
        android:layout_marginBottom="16dp" />

    <!-- Selección de Categoría -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Categoría:"
        android:textColor="#156082"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgEditCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/rbEditFamilia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Familia"
            android:textColor="#333333" />

        <RadioButton
            android:id="@+id/rbEditAmigos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Amigos"
            android:textColor="#333333" />

        <RadioButton
            android:id="@+id/rbEditOtros"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Otros"
            android:textColor="#333333" />
    </RadioGroup>

    <!-- Botón Principal: Guardar Cambios -->
    <Button
        android:id="@+id/btnSaveChanges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar Cambios"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="@drawable/bg_btn_primary"
        android:layout_marginBottom="8dp" />

    <!-- Botón Secundario: Eliminar Contacto -->
    <Button
        android:id="@+id/btnDeleteContact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Eliminar contacto"
        android:textColor="#D32F2F"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@android:color/transparent" />

</LinearLayout>
