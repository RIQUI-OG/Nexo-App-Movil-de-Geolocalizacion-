<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRouteOption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    android:clickable="true"
    android:focusable="true"
    android:backgroundTint="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Fila superior: Horario y Duración total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTimes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="11:34 p.m. — 12:01 a.m."
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="27 min"
                android:textColor="?attr/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Fila intermedia: Badges del recorrido (Paso a paso) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:id="@+id/containerStepsBadges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvStepSummaryFallback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚶 ➔ 🚌 Línea 1 ➔ 🚶"
                    android:textColor="#424242"
                    android:textSize="14sp" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Fila inferior: Precio, Distancia, Frecuencia -->
        <TextView
            android:id="@+id/tvFareAndDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MXN 5.00 • 12.5 km • Cada 3 min"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
