<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    tools:context=".CreateRouteActivity">

    <!-- Header con Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarCreateRoute"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Crear Ruta - Google Maps"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <!-- Formulario Principal -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        android:backgroundTint="?attr/colorSurface">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Nombre de la ruta -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRouteName"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre de la ruta (Ej: Trabajo - Casa)"
                    android:textColorHint="#757575"
                    app:boxStrokeColor="#156082"
                    app:hintTextColor="?attr/colorPrimary"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRouteName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Barra Superior de Medios de Transporte (Estilo Google Maps) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="10dp">

                    <RadioGroup
                        android:id="@+id/rgTransportMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbTransit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚌 Transporte"
                            android:checked="true"
                            android:textColor="#333333"
                            android:layout_marginEnd="6dp" />

                        <RadioButton
                            android:id="@+id/rbDriving"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚗 Auto"
                            android:textColor="#333333"
                            android:layout_marginEnd="6dp" />

                        <RadioButton
                            android:id="@+id/rbWalking"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚶 Caminando"
                            android:textColor="#333333"
                            android:layout_marginEnd="6dp" />

                        <RadioButton
                            android:id="@+id/rbBicycling"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚴 Bicicleta"
                            android:textColor="#333333" />

                    </RadioGroup>

                </HorizontalScrollView>

                <!-- Botón rápido para usar ubicación actual -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUseCurrentLocation"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Usar mi ubicación actual como partida"
                    android:textColor="?attr/colorPrimary"
                    app:chipIcon="@android:drawable/ic_menu_mylocation"
                    app:chipIconTint="#156082"
                    app:chipBackgroundColor="#E1F5FE"
                    android:layout_marginBottom="8dp" />

                <!-- Contenedor de Origen y Destino con botón Swap ⇅ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Partida / Origen -->
                        <AutoCompleteTextView
                            android:id="@+id/etOrigin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="🔘 Partida (Dirección o nombre)"
                            android:inputType="text"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp"
                            android:padding="12dp"
                            android:background="@drawable/edittext_background"
                            android:completionThreshold="3"
                            android:layout_marginBottom="6dp" />

                        <!-- Destino -->
                        <AutoCompleteTextView
                            android:id="@+id/etDestination"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="📍 Destino (Dirección o nombre)"
                            android:inputType="text"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp"
                            android:padding="12dp"
                            android:background="@drawable/edittext_background"
                            android:completionThreshold="3" />

                    </LinearLayout>

                    <!-- Botón Swap ⇅ -->
                    <ImageView
                        android:id="@+id/btnSwapLocations"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:src="@android:drawable/ic_popup_sync"
                        app:tint="#156082"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"
                        android:contentDescription="Intercambiar Origen y Destino" />

                </LinearLayout>

                <!-- Botón de Buscar Rutas -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalculateRoute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔍 Buscar Opciones de Ruta con Google Maps"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorSecondary"
                    app:cornerRadius="10dp"
                    android:layout_marginBottom="8dp" />

                <!-- Información de Estado de Búsqueda -->
                <TextView
                    android:id="@+id/tvRouteInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👉 Escribe origen y destino (o toca el mapa) para ver todas las formas de llegar"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- Lista Vertical de Opciones de Ruta (Estilo Google Maps) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRouteOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp" />

                <!-- Fragmento de Mapa de Google -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="10dp">

                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/createRouteMapFragment"
                        android:name="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </androidx.cardview.widget.CardView>

                <!-- Botones de Acción -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearPoints"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔄 Limpiar"
                        android:textColor="#D32F2F"
                        app:strokeColor="#D32F2F"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveRoute"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="💾 Guardar Ruta"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/colorPrimary"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

</LinearLayout>
