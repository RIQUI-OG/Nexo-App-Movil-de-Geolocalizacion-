<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:padding="20dp"
    tools:context=".TripScheduleActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Header con Logo -->
        <ImageView
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Logo Nexo"
            android:src="@drawable/logo_nexo" />

        <!-- Título Principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Programar Viaje"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:text="Tu familia recibirá actualizaciones de tu viaje"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:alpha="0.9"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Card Container -->
        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/form_background"
            android:padding="24dp"
            android:elevation="8dp">

            <!-- Destino -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Destino"
                android:textColor="#156082"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etDestination"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/edittext_background"
                android:hint="¿A dónde vas?"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#156082"
                android:textColorHint="#156082"
                android:textSize="15sp" />

            <!-- Tipo de Viaje -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tipo de Viaje"
                android:textColor="#156082"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/seekBarTripType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="3"
                android:progress="1"
                android:progressTint="#00BFA6"
                android:thumbTint="#156082"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTripTypeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Viaje Regular"
                android:textColor="#156082"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Fecha y Hora en fila -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <!-- Fecha -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fecha de Salida"
                        android:textColor="#156082"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnDatePicker"
                        android:layout_width="140dp"
                        android:layout_height="40dp"
                        android:background="@drawable/button_rounded_white"
                        android:textColor="#156082"
                        android:text="SELECCIONAR"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSelectedDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No seleccionada"
                        android:textColor="#156082"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Hora -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hora de Salida"
                        android:textColor="#156082"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnTimePicker"
                        android:layout_width="140dp"
                        android:layout_height="40dp"
                        android:background="@drawable/button_rounded_white"
                        android:textColor="#156082"
                        android:text="SELECCIONAR"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSelectedTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No seleccionada"
                        android:textColor="#156082"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Nivel de Seguridad -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nivel de Seguridad"
                android:textColor="#156082"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¿Qué tan seguido quieres que tu familia reciba actualizaciones?"
                android:textColor="#156082"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <RatingBar
                android:id="@+id/ratingBarSecurity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="1"
                android:progressTint="#00BFA6"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvSecurityValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seguridad: Básica"
                android:textColor="#156082"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Botón Principal -->
            <Button
                android:id="@+id/btnScheduleTripConfirm"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/button_rounded_primary"
                android:text="🗓️ PROGRAMAR VIAJE"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:elevation="4dp" />

        </LinearLayout>

        <!-- Footer Text -->
        <TextView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tu familia será notificada automáticamente"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:alpha="0.8"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>