<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center">

    <!-- Nombre sobre el marcador -->
    <TextView
        android:id="@+id/tvMarkerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/bg_dialog_rounded"
        android:backgroundTint="#156082"
        android:elevation="4dp"
        android:layout_marginBottom="2dp" />

    <!-- Foto de Perfil en un marco circular de pin -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMarkerBorder"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        android:backgroundTint="#156082">

        <ImageView
            android:id="@+id/imgMarkerPhoto"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person"
            android:contentDescription="Foto de perfil en mapa" />

    </androidx.cardview.widget.CardView>

    <ImageView
        android:layout_width="16dp"
        android:layout_height="12dp"
        android:src="@android:drawable/arrow_down_float"
        app:tint="#156082"
        android:layout_marginTop="-4dp" />

</LinearLayout>
